# Copy to .env and replace every example. Keep secrets private and out of Git.
# Use URL-safe random values (letters, numbers, underscore, hyphen) for both secrets.
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_URL_SAFE_PASSWORD
ADMIN_API_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS

# Public site origin, no trailing slash. This starter binds local ports only;
# put a TLS reverse proxy in front before any public exposure.
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

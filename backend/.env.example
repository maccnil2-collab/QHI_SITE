# Copy to .env and set a privately generated database credential.
DATABASE_URL=postgresql+psycopg://qhi_auto_app:CHANGE_ME@localhost:5432/qhi_auto
CORS_ORIGINS=http://localhost:3000

# Set to a private durable filesystem mount for staff-managed order documents.
# Leave unset to keep upload and download endpoints disabled.
DOCUMENT_STORAGE_PATH=

# Generate a private random value of at least 32 characters for admin API access.
ADMIN_API_KEY=REPLACE_WITH_RANDOM_SECRET
